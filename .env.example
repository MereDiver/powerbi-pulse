# Optional: constrain interactive sign-in to a Microsoft Entra tenant.
# Leave empty to use powerbiclient's default authority.
PULSE_TENANT_ID=

# Optional PAC auto-discovery. The notebook UI defaults to this value.
PULSE_USE_PAC=false

# REST and health-check tuning.
PULSE_REQUEST_TIMEOUT_SECONDS=30
PULSE_SLOW_EXPORT_THRESHOLD_SECONDS=2.0
PULSE_HIGHLIGHT_THRESHOLD_SECONDS=5.0

# Optional exact-match skip rules. Keep this as a single-line JSON array.
# Example shape (use your own non-sensitive names only in local .env files):
# [{"report":"Report name","page":"Page name","visual":"Visual title"}]
PULSE_SKIP_VISUALS_JSON=[]

